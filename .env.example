# Neon pooled connection: Spring Boot runtime
DB_URL=jdbc:postgresql://REPLACE_WITH_POOLED_HOST/REPLACE_WITH_DATABASE?sslmode=require
DB_USERNAME=REPLACE_WITH_APP_RUNTIME_ROLE
DB_PASSWORD=REPLACE_WITH_APP_RUNTIME_PASSWORD

# Neon direct connection: Flyway migration only
FLYWAY_DB_URL=jdbc:postgresql://REPLACE_WITH_DIRECT_HOST/REPLACE_WITH_DATABASE?sslmode=require
FLYWAY_DB_USERNAME=REPLACE_WITH_MIGRATION_OWNER_ROLE
FLYWAY_DB_PASSWORD=REPLACE_WITH_MIGRATION_OWNER_PASSWORD
# Allowed values after written approval: NEW_OR_SAMPLE, LEGACY_OPERATIONAL
MIGRATION_SOURCE_CLASS=REPLACE_WITH_APPROVED_SOURCE_CLASS

# Log retention uses a distinct direct connection and never shares the web
# runtime credential. The retention container can only invoke the fixed,
# database-owned 2-year audit and 90-day tag-event purge batches.
RETENTION_DB_URL=jdbc:postgresql://REPLACE_WITH_DIRECT_HOST/REPLACE_WITH_DATABASE?sslmode=require
RETENTION_DB_USERNAME=REPLACE_WITH_RETENTION_WORKER_ROLE
RETENTION_DB_PASSWORD=REPLACE_WITH_RETENTION_WORKER_PASSWORD
# Runs immediately after container start, then once per minute. 25 bounded
# transactions per log on each run provide controlled catch-up after downtime.
RETENTION_RUN_INTERVAL_SECONDS=60
RETENTION_CATCHUP_INTERVAL_SECONDS=1

# Apply versioned migrations only in explicitly selected environments.
FLYWAY_ENABLED=false

# M3 invitation/reset deployment values
# Decide the real HTTPS URL immediately before deployment.
PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_HOST
# Caddy site address. Scheme or path 없이 DNS hostname만 입력한다.
PUBLIC_HOST=REPLACE_WITH_PUBLIC_HOST
# ACME 인증서 발급 장애 통지를 받을 운영자 주소다.
ACME_CONTACT_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
# Generate a cryptographically random value of at least 32 bytes. Do not type a
# memorable phrase and do not commit the filled .env file.
ACCOUNT_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# M4 device API values. Keep the API disabled until one INACTIVE device has
# received its generated key and the credential test path is ready.
DEVICE_API_ENABLED=false
DEVICE_CREDENTIAL_PEPPER=REPLACE_WITH_SEPARATE_AT_LEAST_32_RANDOM_BYTES
# Caddy-to-application authentication. Generate a third independent random value.
TRUSTED_PROXY_TOKEN=REPLACE_WITH_SEPARATE_AT_LEAST_32_RANDOM_BYTES

# Keep false during migration/read-only checks. Enable only for the approved
# administrator cutover window.
ADMIN_WRITE_ENABLED=false

# Scheduler is the final cutover flag and remains disabled until the first
# check-in has been reconciled.
ATTENDANCE_SCHEDULER_ENABLED=false

# Backup deployment remains intentionally deferred. When approved, configure the
# separate job and status handoff documented in ops/backup/README.md; backup
# credentials never belong in this web runtime .env. This is separate from the
# always-on log retention worker above.

# The first SYSTEM_ADMIN username and password intentionally do not belong here.
# Enter both through the one-time interactive bootstrap CLI so that credentials
# do not remain in .env, process arguments, shell history, or application logs.
