# Neon pooled connection: Spring Boot runtime
DB_URL=jdbc:postgresql://REPLACE_WITH_POOLED_HOST/REPLACE_WITH_DATABASE?sslmode=require
DB_USERNAME=REPLACE_WITH_DATABASE_ROLE
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Neon direct connection: Flyway, pg_dump, pg_restore
FLYWAY_DB_URL=jdbc:postgresql://REPLACE_WITH_DIRECT_HOST/REPLACE_WITH_DATABASE?sslmode=require
FLYWAY_DB_USERNAME=REPLACE_WITH_DATABASE_ROLE
FLYWAY_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Never run the legacy schema.sql/data.sql automatically.
SQL_INIT_MODE=never
