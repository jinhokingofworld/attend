<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.attend.repository.MemberMapper">
    <select id="findAll" resultType="com.example.attend.entity.Member">
        SELECT * FROM member
        ORDER BY id ASC
    </select>

    <select id="findById" resultType="com.example.attend.entity.Member">
        SELECT * FROM member WHERE id = #{id}
    </select>

    <!-- 파라미터가 하나이기 때문에 @Param을 생략한 것-->
    <insert id="insertMember">
        INSERT INTO member (name, age, phone, birth)
        VALUES (#{name}, #{age}, #{phone}, #{birth})
    </insert>

    <update id="updateMember">
        UPDATE member SET name = #{name},
        age = #{age}, phone = #{phone},
        birth = #{birth}, card_uid = #{cardUid}
        WHERE id = #{id}
    </update>

    <delete id="deleteMember">
        DELETE FROM member WHERE id = #{id}
    </delete>
</mapper>


